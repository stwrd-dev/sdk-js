{
  "name": "@stwrd-auth/workers",
  "version": "0.1.0",
  "description": "stwrd SDK for Cloudflare Workers (backend-for-frontend profile): the /auth/* handler, route guards and a Durable Object session store.",
  "keywords": [
    "stwrd",
    "authentication",
    "oidc",
    "oauth2",
    "cloudflare-workers",
    "durable-objects",
    "bff",
    "sessions"
  ],
  "license": "MIT",
  "author": {
    "name": "stwrd",
    "url": "https://stwrd.dev"
  },
  "homepage": "https://stwrd.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stwrd-dev/sdk-js.git",
    "directory": "packages/workers"
  },
  "bugs": {
    "url": "https://github.com/stwrd-dev/sdk-js/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -b tsconfig.json && tsc -p tests/tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@stwrd-auth/core": "0.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "wrangler": "4.124.0"
  }
}
